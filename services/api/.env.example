# Required — the app will not start without this. Generate one with:
# python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=

RESEND_API_KEY=<your real Resend API key>
RESEND_FROM_EMAIL=onboarding@resend.dev
FRONTEND_URL=http://localhost:3000
PASSWORD_RESET_EXPIRE_MINUTES=30

# Inventory milestone -- Supabase (Connect -> Direct -> Transaction pooler -> URI)
# IMPORTANT: Supabase's dashboard gives you a plain "postgresql://" string --
# rewrite the scheme to "postgresql+psycopg://" (psycopg3) before pasting it
# here, or SQLAlchemy will try to use psycopg2 instead.
# Example shape (not a real value):
# DATABASE_URL=postgresql+psycopg://postgres.xxxxx:[YOUR-PASSWORD]@aws-1-us-east-2.pooler.supabase.com:6543/postgres
DATABASE_URL=
