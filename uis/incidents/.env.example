# Only needed if the frontend and the API aren't reachable from each other
# at plain "localhost" — e.g. when running in GitHub Codespaces, where the
# browser and the forwarded ports are not on the same machine.
#
# If you're running both `npm run dev` and `uvicorn` fully locally (same
# laptop, no Codespace), you can leave this file out entirely — the app
# already defaults to http://localhost:8000.
#
# To use it: copy this file to .env.local (which is gitignored) and set
# it to your Codespace's forwarded URL for port 8000, found in the Ports
# tab. Then restart `npm run dev` — Next.js only reads env files on startup.
NEXT_PUBLIC_API_URL=https://your-codespace-name-8000.app.github.dev
