# This file is for Docker Compose only -- it's separate from
# services/api/.env, which the API also uses for local (non-Docker) dev.
# Fill in a real .env at the repo root (gitignored) before `docker
# compose up`; this file is the shareable template.

# ---- FastAPI backend (services/api) ----
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=30

RESEND_API_KEY=<your real Resend API key>
RESEND_FROM_EMAIL=onboarding@resend.dev

# NOTE the port: backoffice runs on 3001 in this Docker setup (not 3000
# -- website takes 3000, since both share one container). This is only
# used to build the link inside password-reset emails, but it must
# match wherever backoffice is actually reachable or those links break.
FRONTEND_URL=http://localhost:3001

PASSWORD_RESET_EXPIRE_MINUTES=30

# Supabase (Postgres) -- psycopg3 scheme required: postgresql+psycopg://
# not the plain postgresql:// Supabase's dashboard gives you by default.
DATABASE_URL=

# ---- UI (uis/website + uis/backoffice) ----
# This MUST stay host-reachable, not the Docker service name "api".
# NEXT_PUBLIC_ variables are read by the BROWSER (client components),
# and the browser is outside the Docker network entirely -- it cannot
# resolve container hostnames. Using the service name here wouldn't be
# "more correct" per the brief's networking note, it would silently
# break every API call the frontend makes.
NEXT_PUBLIC_API_URL=http://localhost:8000


# Telemetry capture (see docs/telemetry/telemetry-plan.md). Same host/port
# as NEXT_PUBLIC_API_URL above -- just a different path.
NEXT_PUBLIC_TELEMETRY_ENDPOINT=http://localhost:8000/telemetry/events